# ARM'D — Environment Variables
# ─────────────────────────────────────────────────────────────────
# These are already wired into the code.
# Formspree IDs are hardcoded — no action needed there.
#
# When you get your Stripe account, add these two variables
# in your Vercel dashboard under Settings → Environment Variables:
#
# REACT_APP_STRIPE_PUBLISHABLE_KEY = pk_live_xxxxxxxxxxxx
# REACT_APP_STRIPE_PRICE_ID        = price_xxxxxxxxxxxx
#
# Until then, bookings are captured via Formspree and confirmed immediately.
# ─────────────────────────────────────────────────────────────────

REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WHEN_YOU_HAVE_STRIPE
REACT_APP_STRIPE_PRICE_ID=price_REPLACE_WHEN_YOU_HAVE_STRIPE
